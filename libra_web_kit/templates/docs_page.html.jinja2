<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
{% if description %}
  <meta name="description" content="{{ description }}">
{% endif %}
  <meta name="robots" content="noindex">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <a href="/" class="navbar-brand" style="text-decoration:none"><div class="logo-icon">{{ letter }}</div>{{ brand }}</a>
  <div class="navbar-links">
    <a href="/#funciones">Funciones</a>
    <a href="/#planes">Planes</a>
    <a href="/docs/"{% if is_index %} class="active"{% endif %} style="color:var(--brand)">Documentación</a>
  </div>
</nav>

<div class="docs-wrapper">
  <nav class="docs-sidebar">
{% for item in sidebar %}
{% if item.type == 'section' %}
    <div class="docs-sidebar-section">{{ item.text }}</div>
{% else %}
    <a href="{{ item.href }}"{% if item.href == active_href %} class="active"{% endif %}>{{ item.text }}</a>
{% endif %}
{% endfor %}
  </nav>

  <main class="docs-content">
    {{ content_html | safe }}
  </main>
</div>

{{ footer_html | safe }}
</body>
</html>
