limit_req_zone $binary_remote_addr zone=logindocs:10m rate=5r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/html text/css application/javascript;

    # La IP real del cliente (ADR-007). Sin esto `$remote_addr` es siempre NPM,
    # y el `limit_req` de /login-docs era UNO para todo el mundo: 5 pedidos por
    # minuto entre todos los usuarios de la landing. `real_ip` toma la IP de
    # `X-Forwarded-For` desde la derecha salteando estas redes, y SOLO si el par
    # directo es una de ellas: quien entra por el puerto publicado del host no
    # elige su IP. Son las mismas redes que `REDES_DE_CONFIANZA` de docs_auth.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from ::1/128;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /404.html {
        internal;
    }

    # Backend de acceso a /docs/ (login/logout de documentación)
    location /login-docs {
        limit_req zone=logindocs burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://${AUTH_UPSTREAM}:8000;
        proxy_set_header Host $host;
        # Este nginx agrega su salto. Sin esto el header llegaba al backend tal
        # cual lo mandó el cliente, y quien entrara por el puerto publicado del
        # host elegía la IP con la que docs_auth cuenta los fallidos.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /logout-docs {
        proxy_pass http://${AUTH_UPSTREAM}:8000;
        proxy_set_header Host $host;
    }

    # Chequeo interno usado por auth_request — nunca accesible directamente
    location = /internal/check-docs-auth {
        internal;
        proxy_pass http://${AUTH_UPSTREAM}:8000/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location /docs/ {
        auth_request /internal/check-docs-auth;
        error_page 401 = @docs_login_redirect;
        try_files $uri $uri/ $uri.html =404;
    }

    location @docs_login_redirect {
        return 302 /login-docs;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
}
